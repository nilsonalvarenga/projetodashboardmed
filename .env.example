# ====== Supabase ======
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # chave pública (frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # chave de servidor — NUNCA expor no client

# ====== Embeddings (OpenAI) ======
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small      # 1536 dims (combina com o schema)

# ====== Geração da resposta clínica ======
# Provedor: "openai" ou "anthropic"
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4.1
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

# ====== RAG ======
RAG_MATCH_COUNT=8
RAG_SIMILARITY_THRESHOLD=0.2

# ====== App ======
NEXT_PUBLIC_APP_NAME="Dashboard Médico RAG"
